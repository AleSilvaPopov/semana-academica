# =====================================================================
# Semana Acadêmica de Computação da UFGD - variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores (cp .env.example .env).
# NUNCA versione o arquivo .env: ele contém senhas e a APP_KEY.
# =====================================================================

# --- Aplicação ---------------------------------------------------------
APP_NAME="Semana Acadêmica de Computação"
# local em desenvolvimento, production no servidor
APP_ENV=local
# Gerada com "php artisan key:generate" (deixe vazio aqui)
APP_KEY=
# true só em desenvolvimento: mostra erros detalhados e libera a página /status
APP_DEBUG=true
# Endereço público do sistema (usado em links, e-mails e no /storage)
APP_URL=http://localhost:8000
# Fuso de Dourados/MS
APP_TIMEZONE=America/Campo_Grande

# Interface e mensagens de validação em português do Brasil
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logs --------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Em produção use "error"
LOG_LEVEL=debug

# --- Banco de dados (MySQL 8 com o script database/sql/script.sql) -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=semana_academica
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Mesma collation do script. Em MariaDB use utf8mb4_unicode_ci
DB_COLLATION=utf8mb4_0900_ai_ci

# --- Sessão, cache e filas ---------------------------------------------
# O banco NÃO tem as tabelas sessions/cache/jobs do Laravel (e não deve
# ser alterado), por isso tudo usa arquivos ou execução síncrona.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção com HTTPS, use true
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# Uploads (fotos dos ministrantes) vão para storage/app/public,
# exposto em /storage pelo comando "php artisan storage:link"
FILESYSTEM_DISK=local

# --- E-mail (usado só no "Esqueci minha senha" do portal) --------------
# "log" grava o e-mail em storage/logs/laravel.log (desenvolvimento).
# Em produção configure um SMTP real (ex.: smtp, host, porta, usuário e senha).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@semanacomputacao.ufgd.edu.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
